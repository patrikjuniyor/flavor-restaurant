# Flavor — shared editor configuration
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{php,inc}]
indent_style = tab
indent_size = 4

[*.{css,scss}]
indent_style = tab
indent_size = 4

[*.{js,mjs,cjs,json}]
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{diff,patch}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Persian docs and demo fixtures are UTF-8; never let an editor re-encode them.
[docs/**.md]
charset = utf-8
