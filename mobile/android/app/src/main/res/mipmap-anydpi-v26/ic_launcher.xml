<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (Android 8.0+).
  The background is a flat brand colour and the cloche mark ships as a
  drawable-layer vector, so OEM shapes (circle, squircle, rounded square)
  crop it correctly instead of letterboxing a pre-baked square icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
