<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications (development default; Apple rewrites per profile in CI).
		 Docs: docs/PUSH-NOTIFICATIONS.md -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- Associated Domains for Universal Links (default tenant host;
		 brand provisioning rewrites this file per brand via
		 mobile/scripts/provision_brand.py with the brand config file) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:restaurant.example.com</string>
	</array>
</dict>
</plist>
