# *.mo
__pycache__/

# Push credentials (per brand, NEVER commit — see docs/PUSH-NOTIFICATIONS.md)
mobile/android/app/google-services.json
mobile/ios/Runner/GoogleService-Info.plist
AuthKey-*.p8
*service-account*.json

# Release signing material (NEVER commit — docs/MOBILE-RELEASE-CHECKLIST.md)
*.keystore
*.jks
mobile/android/keystore.properties
*.p12
*.mobileprovision
mobile/assets/deeplinks/generated/  # regenerated by provision_brand.py in CI

# iOS project is generated in CI (flutter create), brand-provisioned per build
mobile/ios/Runner.xcodeproj/

# Coding-standards report (CI artifact, regenerated every run)
phpcs-report.txt
